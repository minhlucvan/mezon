{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mezon",
  "version": "1.4.61",
  "identifier": "app.mezon.ai",
  "build": {
    "beforeDevCommand": "yarn dev:chat",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "yarn build:tauri:renderer",
    "frontendDist": "../../../dist/apps/chat"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mezon",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright © 2024 Mezon App",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Mezon - Live, Work, and Play platform. A modern communication app for teams and communities.",
    "shortDescription": "Mezon Desktop Application",
    "targets": "all",
    "publisher": "Mezon App",
    "licenseFile": "../../../LICENSE",
    "resources": [],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"],
        "headerImage": null,
        "sidebarImage": null
      },
      "wix": null
    },
    "linux": {
      "appId": "app.mezon.ai",
      "section": "utils",
      "priority": "optional",
      "files": {},
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "providerShortName": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://cdn.mezon.ai/tauri-release/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["mezonapp"]
      }
    }
  }
}
