{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mezon",
  "version": "1.4.61",
  "identifier": "app.mezon.ai",
  "build": {
    "beforeDevCommand": "yarn dev:chat",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "yarn build:desktop-tauri:renderer",
    "frontendDist": "../../../dist/apps/chat"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mezon",
        "label": "main",
        "width": 1280,
        "height": 720,
        "minWidth": 950,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "tabbingIdentifier": "mezon"
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "title": "Mezon"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright © 2024 Mezon App",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Mezon - Live, Work, and Play platform. A modern communication app for teams and communities with real-time messaging, voice, and video.",
    "shortDescription": "Mezon Desktop Application",
    "targets": "all",
    "publisher": "Mezon App",
    "resources": [
      "assets/**/*"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"],
        "headerImage": null,
        "sidebarImage": null,
        "license": null,
        "runAfterFinish": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true
      },
      "wix": null
    },
    "linux": {
      "appId": "app.mezon.ai",
      "section": "utils",
      "priority": "optional",
      "files": {},
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ],
        "desktopTemplate": null
      },
      "rpm": {
        "depends": []
      }
    },
    "macOS": {
      "entitlements": "assets/entitlements.mac.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "providerShortName": null,
      "dmgLicense": null
    },
    "iOS": {
      "developmentTeam": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://cdn.mezon.ai/tauri-release/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["mezonapp"]
      }
    }
  }
}
